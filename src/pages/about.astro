---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WavyEdge from '../components/WavyEdge.astro';
import selfPortrait from '../assets/illustrations/selfportrait.png';
import '../styles/about.css';

/* Interests as draggable stickers — each with a scattered start spot + lean. */
const interests = [
	{ label: 'creative coding', x: 3, y: 6, rot: -7, color: 'var(--color-blue)' },
	{ label: 'badminton', x: 55, y: 3, rot: 6, color: 'var(--color-green)' },
	{ label: 'painting', x: 30, y: 24, rot: -3, color: 'var(--color-orange)' },
	{ label: 'music', x: 66, y: 30, rot: 8, color: 'var(--color-pink)' },
	{ label: 'walks', x: 8, y: 44, rot: 4, color: 'var(--color-green)' },
	{ label: 'films', x: 44, y: 56, rot: -6, color: 'var(--color-blue)' },
	{ label: 'puzzles', x: 70, y: 62, rot: 5, color: 'var(--color-orange)' },
	{ label: 'reading', x: 20, y: 74, rot: -4, color: 'var(--color-pink)' },
];

/* Tools that "spill out" of the bag. Order roughly = the arc they fan into. */
const toolNames = [
	['figma', 'Figma'],
	['figjam', 'FigJam'],
	['miro', 'Miro'],
	['photoshop', 'Photoshop'],
	['illustrator', 'Illustrator'],
	['aftereffects', 'After Effects'],
	['procreate', 'Procreate'],
	['sketchbook', 'Sketchbook'],
	['blender', 'Blender'],
	['flippaclip', 'FlippaClip'],
	['html', 'HTML'],
	['css', 'CSS'],
	['javascript', 'JavaScript'],
	['php', 'PHP'],
	['p5', 'p5.js'],
	['vscode', 'VS Code'],
	['github', 'GitHub'],
	['behance', 'Behance'],
];

/* Where each icon lands once it's tipped out — a hand-scattered spill that
   fans from the bag (upper-left) toward the bottom-right. [x%, y%, rotate°] */
const spots = [
	[39, 33, -11], [53, 24, 7], [65, 31, -5], [77, 19, 13],
	[37, 50, 9], [51, 58, -8], [66, 45, 12], [82, 52, -4], [93, 34, 8],
	[43, 73, 6], [58, 63, -11], [72, 76, 10], [86, 64, -6], [95, 79, 9],
	[48, 88, -8], [63, 85, 11], [79, 89, -5], [91, 90, 7],
];

const tools = toolNames.map(([slug, name], i) => {
	const [x, y, rot] = spots[i % spots.length];
	return { slug, name, x, y, rot };
});
---

<BaseLayout
	title="The Lore"
	description="The lore behind Linde D'Hauwe, a Digital Design & Development student from Leuven, based in Kortrijk."
>
	<section class="lore">
		<div class="lore__inner">
			<h1 class="lore__title">The Lore</h1>

			<p class="lore__intro">
				Hi, I’m Linde, a 20-year-old Digital Design and Development student at Howest in Kortrijk. Born and raised in Leuven, I now live in student housing in Kortrijk while studying, creating and figuring out where my ideas can take me. I’m a curious and creative person who enjoys combining design, technology and a little bit of experimentation.
			</p>

			<p class="lore__note">But there’s more to me than just what I study so, here’s the lore.</p>
		</div>

		<Image
			class="lore__portrait"
			src={selfPortrait}
			alt="Illustrated self-portrait of Linde"
			widths={[360, 560, 800]}
			sizes="(min-width: 48rem) 26rem, 60vw"
			loading="eager"
		/>
	</section>

	<section class="interests">
		<WavyEdge color="var(--color-blush)" variant={2} />

		<div class="interests__inner">
			<h2 class="interests__heading">My interests</h2>

			<p class="interests__lead">
				I&rsquo;m passionate about design and user experience, and I love making
				thoughtful, imaginative things. Creative coding is a hobby I do purely
				for fun. Outside my studies, grab one and shuffle them around:
			</p>

			<ul
				class="interest-board"
				data-interest-board
				aria-label="Interests: creative coding, badminton, painting, music, walks, films, puzzles, reading"
			>
				{
					interests.map((it) => (
						<li
							class="sticker"
							style={`--x:${it.x}%; --y:${it.y}%; --rot:${it.rot}deg; --accent:${it.color};`}
						>
							{it.label}
						</li>
					))
				}
			</ul>

			<p class="interests__foot">
				I come from an artistic background, with a diploma in arts education
				from SLAC academy in Leuven, and in secondary school I studied
				economics and humanities.
			</p>
		</div>
	</section>

	<script>
		function initInterestBoard() {
			document
				.querySelectorAll<HTMLElement>('[data-interest-board]')
				.forEach((board) => {
					if (board.dataset.bound) return;
					board.dataset.bound = 'true';
					let z = 10;

					board.querySelectorAll<HTMLElement>('.sticker').forEach((s) => {
						let dragging = false;
						let px = 0;
						let py = 0;
						let dx = 0;
						let dy = 0;

						s.addEventListener('pointerdown', (e) => {
							dragging = true;
							px = e.clientX;
							py = e.clientY;
							dx = parseFloat(s.style.getPropertyValue('--dx')) || 0;
							dy = parseFloat(s.style.getPropertyValue('--dy')) || 0;
							s.style.zIndex = String(++z);
							s.classList.add('is-held');
							s.setPointerCapture(e.pointerId);
						});

						s.addEventListener('pointermove', (e) => {
							if (!dragging) return;
							s.style.setProperty('--dx', dx + (e.clientX - px) + 'px');
							s.style.setProperty('--dy', dy + (e.clientY - py) + 'px');
						});

						const end = (e: PointerEvent) => {
							dragging = false;
							s.classList.remove('is-held');
							try {
								s.releasePointerCapture(e.pointerId);
							} catch {}
						};
						s.addEventListener('pointerup', end);
						s.addEventListener('pointercancel', end);
					});
				});
		}

		initInterestBoard();
		document.addEventListener('astro:page-load', initInterestBoard);
	</script>

	<section class="bag">
		<WavyEdge color="var(--color-blue)" variant={3} />

		<div class="bag__inner">
			<h2 class="bag__heading">What&rsquo;s in my bag</h2>
			<p class="bag__note">The tools I actually reach for, tipped out.</p>
		</div>

		<div class="bag-scene" data-bag-scene>
			<img
				class="bag-scene__handle"
				src="/bag-handle.webp"
				alt=""
				aria-hidden="true"
				width="780"
				height="1051"
			/>

			<ul class="bag-scene__icons">
				{
					tools.map((tool, i) => (
						<li
							class="bag-icon"
							style={`--x:${tool.x}%; --y:${tool.y}%; --r:${tool.rot}deg; --i:${i};`}
						>
							<img
								src={`/logos/${tool.slug}.webp`}
								alt={tool.name}
								width="160"
								height="160"
								loading="lazy"
							/>
							<span class="bag-icon__name">{tool.name}</span>
						</li>
					))
				}
			</ul>

			<img
				class="bag-scene__front"
				src="/bag.webp"
				alt="Linde's tote bag, patches and all"
				width="780"
				height="1051"
			/>
		</div>
	</section>
</BaseLayout>

<script>
	function initBagScene() {
		document
			.querySelectorAll<HTMLElement>('[data-bag-scene]')
			.forEach((scene) => {
				if (!('IntersectionObserver' in window)) {
					scene.classList.add('is-open');
					return;
				}
				new IntersectionObserver(
					([entry]) => scene.classList.toggle('is-open', entry.isIntersecting),
					{ threshold: 0.35 },
				).observe(scene);
			});
	}

	initBagScene();
	document.addEventListener('astro:page-load', initBagScene);
</script>
