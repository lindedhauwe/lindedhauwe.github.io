---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sparkle from '../../components/Sparkle.astro';
import { withBase } from '../../lib/paths';
import { categories, projectsIn } from '../../data/projects';
import '../../styles/projects.css';

const sparkleColours = [
	'var(--color-blush)',
	'var(--color-orange)',
	'var(--color-pink)',
	'var(--color-green)',
];

// Split by word (not by character) so each word wraps as one unit — on a
// narrow screen the old flat per-letter markup let the browser break
// "project" mid-word since nothing tied its letters together.
const wallTitleWords = 'The project wall'.split(' ');
---

<BaseLayout
	title="Projects"
	description="The project wall: everything Linde D'Hauwe has built, pinned up by discipline across visual design, motion design, user experience and development."
>
	<section class="wall">
		<Sparkle
			class="wall__sparkle wall__sparkle--intro-a sparkle--lg"
			color="var(--color-orange)"
		/>
		<Sparkle class="wall__sparkle wall__sparkle--intro-b" color="var(--color-pink)" />
		<Sparkle
			class="wall__sparkle wall__sparkle--intro-c"
			color="var(--color-blush)"
		/>

		<header class="wall__intro">
			<h1 class="wall__title" aria-label="The project wall">
				{
					wallTitleWords.map((word, wi) => (
						<Fragment>
							<span class="wall__title-word">
								{[...word].map((ch, ci) => (
									<span
										class="wall__title-letter"
										style={`--i:${wi * 5 + ci}`}
										aria-hidden="true"
									>
										{ch}
									</span>
								))}
							</span>
							{wi < wallTitleWords.length - 1 && ' '}
						</Fragment>
					))
				}
			</h1>
			<p class="wall__lead">
				Everything I&rsquo;ve built so far, pinned up by discipline. Tap a photo
				for the full story.
			</p>
		</header>

		{
			categories.map((cat, i) => (
				<section class="wall__group" aria-labelledby={`cat-${cat.id}`}>
					<Sparkle
						class="wall__sparkle wall__sparkle--1 sparkle--lg"
						color={sparkleColours[i % sparkleColours.length]}
					/>
					<Sparkle
						class="wall__sparkle wall__sparkle--2"
						color={sparkleColours[(i + 2) % sparkleColours.length]}
					/>
					<Sparkle
						class="wall__sparkle wall__sparkle--3"
						color={sparkleColours[(i + 1) % sparkleColours.length]}
					/>
					<Sparkle
						class="wall__sparkle wall__sparkle--4 sparkle--lg"
						color={sparkleColours[(i + 3) % sparkleColours.length]}
					/>

					<h2 class="wall__group-label" id={`cat-${cat.id}`}>
						{cat.label}
					</h2>

					<ul class="wall__grid">
						{projectsIn(cat.id).map((project) => (
							<li class="polaroid">
								<a
									class="polaroid__link"
									href={withBase(`/projects/${project.slug}/`)}
								>
									<span class="polaroid__photo">
										<span class="polaroid__tape" aria-hidden="true" />
										<span class="polaroid__frame">
											<Image
												class="polaroid__img"
												src={project.image}
												alt={project.title}
												widths={[300, 480, 720]}
												sizes="(min-width: 48rem) 15rem, 44vw"
											/>
										</span>
										<span class="polaroid__caption">{project.title}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</section>
</BaseLayout>

<script>
	import { initTapePeel } from '../../lib/tapePeel';

	const initPolaroidPeel = () => initTapePeel('.polaroid');

	initPolaroidPeel();
	document.addEventListener('astro:page-load', initPolaroidPeel);
</script>
