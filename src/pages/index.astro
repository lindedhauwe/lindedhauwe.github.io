---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TiltText from '../components/TiltText.astro';
import headerImg from '../assets/illustrations/header-img.png';
---

<BaseLayout>
	<section class="hero">
		<h1 class="hero__title">
			<span>Portfolio</span>
			<span class="hero__year">2026</span>
		</h1>

		<Image
			class="hero__art"
			src={headerImg}
			alt="Illustration of Linde lying on her back, scrolling on her phone"
			widths={[480, 800, 1200, 1800]}
			sizes="(min-width: 60rem) 60rem, 90vw"
			loading="eager"
			fetchpriority="high"
		/>
	</section>

	<section class="era">
		<div class="era__inner">
			<h2 class="era__title">
				<TiltText text="I'M IN MY DESIGN ERA" />
			</h2>

			<p class="era__lead">
				{/* TODO: replace with real intro copy */}
				Placeholder intro — a line or two about who you are and what you make.
			</p>

			<a class="era__cta" href="/projects/">See the work &rarr;</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* --- Hero --------------------------------------------------------- */
	.hero {
		position: relative;
		display: grid;
		place-items: start center;
		min-height: calc(100svh - 5rem);
		padding: var(--space-l) var(--space-m) 0;
		overflow: hidden;
		background: linear-gradient(
			var(--color-green) 0 58%,
			var(--color-blush) 58% 100%
		);
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		color: var(--color-paper);
		text-align: center;
		font-size: var(--step-6);
		letter-spacing: 0.02em;
		line-height: 0.9;
		text-shadow: 0.06em 0.06em 0 var(--color-ink);
	}

	.hero__title span {
		display: block;
	}

	.hero__year {
		color: var(--color-pink);
		transform: rotate(-3deg);
	}

	.hero__art {
		position: relative;
		z-index: 1;
		width: min(60rem, 92vw);
		height: auto;
		margin-top: auto;
		margin-bottom: -2%;
		filter: drop-shadow(0.4rem 0.5rem 0 rgba(14, 13, 8, 0.12));
	}

	/* --- Design era ------------------------------------------------- */
	.era {
		background: var(--color-blush);
	}

	.era__inner {
		display: grid;
		gap: var(--space-m);
		max-width: var(--content-width);
		margin-inline: auto;
		padding: var(--space-2xl) var(--space-m) var(--space-3xl);
	}

	.era__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--step-5);
		color: var(--color-orange);
		-webkit-text-stroke: 1.5px var(--color-ink);
	}

	.era__lead {
		max-width: 42ch;
		font-size: var(--step-1);
	}

	.era__cta {
		justify-self: start;
		font-family: var(--font-hand);
		font-size: var(--step-2);
		font-weight: 700;
		text-decoration: none;
		color: var(--color-ink);
		border-bottom: 3px solid var(--color-orange);
	}

	.era__cta:hover {
		color: var(--color-orange);
	}
</style>
