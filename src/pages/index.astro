---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EraWord from '../components/EraWord.astro';
import StoryModal from '../components/StoryModal.astro';
import Sparkle from '../components/Sparkle.astro';
import { withBase } from '../lib/paths';
import { featuredWork } from '../data/projects';
import profilePic from '../assets/illustrations/profile-pic.png';
import phoneIllustration from '../assets/illustrations/phone.png';
import '../styles/home.css';
---

<BaseLayout bubbleNav>
	<section class="hero">
		<div class="hero__top">
			<p class="hero__brand">
				<span>Portfolio</span>
				<span class="hero__year">2026</span>
				<span class="hero__name">Linde D&rsquo;Hauwe</span>
			</p>

			<picture>
				<source
					srcset={withBase('/hero-poster.webp')}
					media="(prefers-reduced-motion: reduce)"
				/>
				<img
					class="hero__art"
					src={withBase('/hero-anim-1200.webp')}
					srcset={`${withBase('/hero-anim-760.webp')} 760w, ${withBase('/hero-anim-1200.webp')} 1200w`}
					sizes="(min-width: 40rem) 66vw, 90vw"
					width="1200"
					height="888"
					alt="Animated illustration of Linde lying on her back, scrolling on her phone"
					fetchpriority="high"
					decoding="async"
				/>
			</picture>
		</div>

		<h1 class="hero__statement">
			<span class="hero__word hero__word--im">I'm</span>
			<span class="hero__word hero__word--inmy">in my</span>
			<span class="hero__word hero__word--craft"><EraWord /></span>
			<span class="hero__word hero__word--era">era</span>
		</h1>

		<span class="hero__annotation" aria-hidden="true">
			Linde
			<svg class="hero__annotation-arrow" viewBox="0 0 70 100">
				<path
					d="M10 4C40 14 58 40 54 96"
					fill="none"
					stroke="currentColor"
					stroke-width="3"
					stroke-linecap="round"
				/>
				<path
					d="M42 86L54 96L60 80"
					fill="none"
					stroke="currentColor"
					stroke-width="3"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</span>
	</section>

	<section class="about-teaser">
		<div class="about-teaser__inner">
			<div class="about-teaser__content">
				<h2 class="about-teaser__heading">Who am I???</h2>
				<p class="about-teaser__body">
					Hi, I&rsquo;m Linde! A creative Digital Design &amp; Development
					student with a passion for turning ideas into meaningful digital
					experiences. I enjoy exploring the space where design, technology
					and creativity meet, and I&rsquo;m always looking for new things to
					learn and create.
				</p>
				<p class="about-teaser__prompt">
					Want to know more about the person behind the projects?
				</p>
				<a class="btn" href={withBase("/about/")}>More about me</a>
			</div>

			<figure class="story">
				<button
					class="story__open"
					type="button"
					data-story-open
					aria-label="Open Linde's story"
				>
					<span class="story__ring">
						<span class="story__inner">
							<Image
								class="story__img"
								src={profilePic}
								alt="Illustrated portrait of Linde D'Hauwe"
								widths={[200, 320, 480]}
								sizes="15rem"
							/>
						</span>
					</span>
					<span class="story__flag" aria-hidden="true">
						new story!
						<svg
							class="story__flag-line"
							viewBox="0 0 120 10"
							preserveAspectRatio="none"
						>
							<path
								d="M2 6C25 3 48 9 68 5C90 1 106 8 118 4"
								fill="none"
								stroke="currentColor"
								stroke-width="3.2"
								stroke-linecap="round"
							/>
						</svg>
					</span>
				</button>
				<figcaption class="story__name">Linde D'Hauwe</figcaption>
			</figure>
		</div>

		<svg
			class="teaser__edge"
			viewBox="0 0 1200 80"
			preserveAspectRatio="none"
			aria-hidden="true"
		>
			<path
				d="M0,80 L0,46 C95,64 150,30 250,42 C345,53 385,22 470,34 C560,47 620,20 720,36 C820,52 875,24 970,38 C1055,50 1110,28 1200,44 L1200,80 Z"
				fill="currentColor"
			/>
		</svg>
	</section>

	<section class="work">
		<Sparkle
			class="home-sparkle home-sparkle--work-1"
			color="var(--color-blush)"
		/>
		<Sparkle
			class="home-sparkle home-sparkle--work-2 sparkle--lg"
			color="var(--color-pink)"
		/>
		<Sparkle
			class="home-sparkle home-sparkle--work-3"
			color="var(--color-orange)"
		/>

		<div class="work__inner">
			<h2 class="work__heading">Selected work</h2>

			<span class="work__slay" aria-hidden="true">
				slay!
				<svg
					class="work__slay-line"
					viewBox="0 0 120 10"
					preserveAspectRatio="none"
				>
					<path
						d="M2 6C25 3 48 9 68 5C90 1 106 8 118 4"
						fill="none"
						stroke="currentColor"
						stroke-width="3.2"
						stroke-linecap="round"
					/>
				</svg>
			</span>

			<ul class="work__grid">
				{
					featuredWork.map((w) => (
						<li class="work-card">
							<a class="work-card__link" href={w.href}>
								<span class="work-card__photo">
									<span class="work-card__tape" aria-hidden="true" />
									<span class="work-card__frame">
										<Image
											class="work-card__img"
											src={w.image}
											alt={w.alt}
											widths={[400, 640, 900]}
											sizes="(min-width: 48rem) 22rem, 90vw"
										/>
										<span class:list={['work-card__field', `work-card__field--${w.category}`]} aria-hidden="true">{w.field}</span>
									</span>
									<span class="work-card__caption">{w.title}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<a class="btn" href={withBase("/projects/")}>See all projects &rarr;</a>
		</div>
	</section>

	<section class="contact">
		<Sparkle
			class="home-sparkle home-sparkle--contact-1"
			color="var(--color-blush)"
		/>
		<Sparkle
			class="home-sparkle home-sparkle--contact-2 sparkle--lg"
			color="var(--color-pink)"
		/>

		<div class="contact__phone" aria-hidden="true" data-contact-phone>
			<Image
				src={phoneIllustration}
				alt=""
				widths={[160, 240, 340]}
				sizes="(min-width: 52rem) 8rem, 1px"
			/>
		</div>

		<div class="contact__grid">
			<div class="contact__inner">
				<h2 class="contact__heading">Text, don&rsquo;t call!</h2>
				<p class="contact__lead">
					Got a project, a question, or just want to say hi? My inbox is
					always open.
				</p>
				<a class="btn" href={withBase("/contact/")}>Get in touch</a>
			</div>
		</div>
	</section>

	<script>
		import { initTapePeel } from '../lib/tapePeel';

		const initWorkCardPeel = () => initTapePeel('.work-card');

		initWorkCardPeel();
		document.addEventListener('astro:page-load', initWorkCardPeel);

		function initContactPhone() {
			const section = document.querySelector<HTMLElement>('.contact');
			if (!section || section.dataset.phoneBound) return;
			section.dataset.phoneBound = 'true';

			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				section.classList.add('is-phone-in');
				return;
			}

			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						section.classList.toggle('is-phone-in', e.isIntersecting);
					}
				},
				{ threshold: 0.3 },
			);
			io.observe(section);
		}

		initContactPhone();
		document.addEventListener('astro:page-load', initContactPhone);
	</script>

	<StoryModal />
</BaseLayout>
