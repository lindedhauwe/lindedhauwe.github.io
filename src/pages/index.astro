---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EraWord from '../components/EraWord.astro';
import { site, socials } from '../config/site';
import { featuredWork } from '../data/projects';
import profilePic from '../assets/illustrations/profile-pic.png';
import '../styles/home.css';
---

<BaseLayout bubbleNav>
	<section class="hero">
		<p class="hero__brand">
			<span>Portfolio</span>
			<span class="hero__year">2026</span>
			<span class="hero__name">Linde D&rsquo;Hauwe</span>
		</p>

		<picture>
			<source
				srcset="/hero-poster.webp"
				media="(prefers-reduced-motion: reduce)"
			/>
			<img
				class="hero__art"
				src="/hero-anim-1200.webp"
				srcset="/hero-anim-760.webp 760w, /hero-anim-1200.webp 1200w"
				sizes="(min-width: 40rem) 66vw, 90vw"
				width="1200"
				height="888"
				alt="Animated illustration of Linde lying on her back, scrolling on her phone"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>

		<h1 class="hero__statement">
			<span class="hero__word hero__word--im">I'm</span>
			<span class="hero__word hero__word--inmy">in my</span>
			<span class="hero__word hero__word--craft"><EraWord /></span>
			<span class="hero__word hero__word--era">era</span>
		</h1>
	</section>

	<section class="about-teaser">
		<div class="about-teaser__inner">
			<div class="about-teaser__content">
				<h2 class="about-teaser__heading">Who am I???</h2>
				<p class="about-teaser__body">
					Hi, I&rsquo;m Linde! A creative Digital Design &amp; Development
					student with a passion for turning ideas into meaningful digital
					experiences. I enjoy exploring the space where design, technology
					and creativity meet, and I&rsquo;m always looking for new things to
					learn and create.
				</p>
				<p class="about-teaser__prompt">
					Want to know more about the person behind the projects?
				</p>
				<a class="btn" href="/about/">More about me</a>
			</div>

			<figure class="story">
				<span class="story__ring">
					<span class="story__inner">
						<Image
							class="story__img"
							src={profilePic}
							alt="Illustrated portrait of Linde D'Hauwe"
							widths={[200, 320, 480]}
							sizes="15rem"
						/>
					</span>
				</span>
				<figcaption class="story__name">Linde D'Hauwe</figcaption>
			</figure>
		</div>
	</section>

	<section class="work">
		<svg
			class="work__edge"
			viewBox="0 0 1200 80"
			preserveAspectRatio="none"
			aria-hidden="true"
		>
			<path
				d="M0,80 L0,46 C95,64 150,30 250,42 C345,53 385,22 470,34 C560,47 620,20 720,36 C820,52 875,24 970,38 C1055,50 1110,28 1200,44 L1200,80 Z"
				fill="currentColor"
			/>
		</svg>

		<div class="work__inner">
			<h2 class="work__heading">Selected work</h2>

			<span class="work__slay" aria-hidden="true">
				slay!
				<svg
					class="work__slay-line"
					viewBox="0 0 120 10"
					preserveAspectRatio="none"
				>
					<path
						d="M2 6C25 3 48 9 68 5C90 1 106 8 118 4"
						fill="none"
						stroke="currentColor"
						stroke-width="3.2"
						stroke-linecap="round"
					/>
				</svg>
			</span>

			<ul class="work__grid">
				{
					featuredWork.map((w) => (
						<li class="work-card">
							<a class="work-card__link" href={w.href}>
								<span class="work-card__photo">
									<span class="work-card__tape" aria-hidden="true" />
									<span class="work-card__frame">
										<Image
											class="work-card__img"
											src={w.image}
											alt={w.alt}
											widths={[400, 640, 900]}
											sizes="(min-width: 48rem) 22rem, 90vw"
										/>
									</span>
									<span class="work-card__caption">{w.title}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<a class="btn" href="/projects/">See all projects &rarr;</a>
		</div>
	</section>

	<section class="contact">
		<svg
			class="contact__edge"
			viewBox="0 0 1200 80"
			preserveAspectRatio="none"
			aria-hidden="true"
		>
			<path
				d="M0,80 L0,54 C90,30 150,62 250,46 C345,31 385,66 470,52 C560,37 620,60 720,42 C820,24 875,60 970,48 C1055,37 1110,54 1200,40 L1200,80 Z"
				fill="currentColor"
			/>
		</svg>

		<div class="contact__inner">
			<h2 class="contact__heading">Text, don&rsquo;t call!</h2>
			<p class="contact__lead">
				Got a project, a question, or just want to say hi? My inbox is always open.
			</p>

			<div class="contact__lines">
				<a class="contact__link" href={`mailto:${site.email}`}>
					<span>{site.email}</span>
					<svg
						class="contact__scribble"
						viewBox="0 0 300 10"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path
							d="M2 6C55 2 95 9 150 5C205 1 250 9 298 4"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
						/>
					</svg>
				</a>
				{
					site.phone && (
						<a
							class="contact__link"
							href={`sms:${site.phone.replace(/\s+/g, '')}`}
						>
							<span>{site.phone}</span>
							<svg
								class="contact__scribble"
								viewBox="0 0 300 10"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<path
									d="M2 5C50 9 100 2 150 6C205 10 255 3 298 6"
									fill="none"
									stroke="currentColor"
									stroke-width="3"
									stroke-linecap="round"
								/>
							</svg>
						</a>
					)
				}
			</div>

			<ul class="contact__socials">
				{
					socials.map((s) => (
						<li>
							<a href={s.href} target="_blank" rel="noopener noreferrer">
								{s.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
