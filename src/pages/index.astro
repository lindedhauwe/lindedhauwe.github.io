---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TiltText from '../components/TiltText.astro';
import EraWord from '../components/EraWord.astro';
import headerImg from '../assets/illustrations/header-img.png';
import '../styles/home.css';
import '../styles/era-word.css';
---

<BaseLayout>
	<section class="hero">
		<p class="hero__brand">
			<span>Portfolio</span>
			<span class="hero__year">2026</span>
		</p>

		<Image
			class="hero__art"
			src={headerImg}
			alt="Illustration of Linde lying on her back, scrolling on her phone"
			widths={[480, 800, 1200, 1800]}
			sizes="(min-width: 60rem) 55rem, 90vw"
			loading="eager"
			fetchpriority="high"
		/>

		<h1 class="hero__statement">
			<span class="hero__word hero__word--im"><TiltText text="I'M" /></span>
			<span class="hero__word hero__word--inmy"><TiltText text="IN MY" /></span>
			<span class="hero__word hero__word--craft"><EraWord /></span>
			<span class="hero__word hero__word--era"><TiltText text="ERA" /></span>
		</h1>
	</section>

	<section class="intro">
		<div class="intro__inner">
			<p class="intro__lead">
				{/* TODO: replace with real intro copy */}
				Placeholder intro — a line or two about who you are and what you make.
			</p>
			<a class="intro__cta" href="/projects/">See the work &rarr;</a>
		</div>
	</section>
</BaseLayout>
