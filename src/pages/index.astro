---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TiltText from '../components/TiltText.astro';
import headerImg from '../assets/illustrations/header-img.png';
---

<BaseLayout>
	<section class="hero">
		<p class="hero__brand">
			<span>Portfolio</span>
			<span class="hero__year">2026</span>
		</p>

		<Image
			class="hero__art"
			src={headerImg}
			alt="Illustration of Linde lying on her back, scrolling on her phone"
			widths={[480, 800, 1200, 1800]}
			sizes="(min-width: 60rem) 55rem, 90vw"
			loading="eager"
			fetchpriority="high"
		/>

		<h1 class="hero__statement">
			<span class="word word--im"><TiltText text="I'M" /></span>
			<span class="word word--inmy"><TiltText text="IN MY" /></span>
			<span class="word word--design"><TiltText text="DESIGN" /></span>
			<span class="word word--era"><TiltText text="ERA" /></span>
		</h1>
	</section>

	<section class="intro">
		<div class="intro__inner">
			<p class="intro__lead">
				{/* TODO: replace with real intro copy */}
				Placeholder intro — a line or two about who you are and what you make.
			</p>
			<a class="intro__cta" href="/projects/">See the work &rarr;</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* --- Hero: mobile-first stack ----------------------------------- */
	.hero {
		position: relative;
		display: grid;
		gap: var(--space-m);
		padding: var(--space-3xl) var(--space-m) var(--space-xl);
		overflow: hidden;
		background: linear-gradient(
			var(--color-green) 0 42%,
			var(--color-blush) 42% 100%
		);
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--step-5);
		line-height: 0.9;
		color: var(--color-paper);
		text-shadow: 0.05em 0.05em 0 var(--color-ink);
	}

	.hero__brand span {
		display: block;
	}

	.hero__year {
		color: var(--color-pink);
	}

	.hero__art {
		width: min(90%, 34rem);
		height: auto;
		justify-self: center;
	}

	.hero__statement {
		display: grid;
		grid-template-columns: auto auto;
		justify-content: space-between;
		gap: 0.05em 0.4em;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 15vw, 5rem);
		line-height: 0.85;
		color: var(--color-ink);
	}

	.word--inmy,
	.word--era {
		justify-self: end;
	}

	/* --- Hero: desktop composition --------------------------------- */
	@media (min-width: 60rem) {
		.hero {
			gap: 0;
			min-height: 100svh;
			padding: 0;
			background: linear-gradient(
				var(--color-green) 0 50%,
				var(--color-blush) 50% 100%
			);
		}

		.hero__brand {
			position: absolute;
			top: 22%;
			left: clamp(1.5rem, 5vw, 5rem);
			font-size: clamp(3rem, 7vw, 6rem);
		}

		.hero__art {
			position: absolute;
			top: 50%;
			right: 3%;
			width: min(58vw, 52rem);
			transform: translateY(-47%);
			z-index: 2;
			filter: drop-shadow(0.4rem 0.5rem 0 rgba(14, 13, 8, 0.12));
		}

		.hero__statement {
			position: absolute;
			inset: auto clamp(1.5rem, 5vw, 5rem) 6%;
			font-size: clamp(4rem, 10vw, 8.5rem);
			row-gap: 0.08em;
		}
	}

	/* --- Intro band ----------------------------------------------- */
	.intro {
		background: var(--color-blush);
	}

	.intro__inner {
		display: grid;
		gap: var(--space-m);
		max-width: var(--content-width);
		margin-inline: auto;
		padding: var(--space-2xl) var(--space-m) var(--space-3xl);
	}

	.intro__lead {
		max-width: 42ch;
		font-size: var(--step-1);
	}

	.intro__cta {
		justify-self: start;
		font-family: var(--font-hand);
		font-size: var(--step-2);
		font-weight: 700;
		text-decoration: none;
		color: var(--color-ink);
		border-bottom: 3px solid var(--color-orange);
	}

	.intro__cta:hover {
		color: var(--color-orange);
	}
</style>
