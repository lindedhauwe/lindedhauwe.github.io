---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
import Sparkle from '../components/Sparkle.astro';
import { site, socials } from '../config/site';
import '../styles/contact.css';

const phoneHref = site.phone
	? `sms:${site.phone.replace(/\s+/g, '')}`
	: null;
---

<BaseLayout
	title="Contact"
	description={`Get in touch with ${site.name}: email, text and socials.`}
>
	<section class="contact-page">
		<Sparkle
			class="contact-sparkle contact-sparkle--1 sparkle--lg"
			color="var(--color-blush)"
		/>
		<Sparkle class="contact-sparkle contact-sparkle--2" color="var(--color-orange)" />
		<Sparkle class="contact-sparkle contact-sparkle--3" color="var(--color-pink)" />
		<Sparkle
			class="contact-sparkle contact-sparkle--4 sparkle--lg"
			color="var(--color-green)"
		/>
		<Sparkle class="contact-sparkle contact-sparkle--5" color="var(--color-blush)" />

		<div class="contact-page__inner">
			<div class="contact-page__content">
				<h1 class="contact-page__title">
					Let&rsquo;s <span class="contact-page__mark">talk</span>!
				</h1>

				<p class="contact-page__lead">
					Whether it&rsquo;s a project, a question, or just a hello, I&rsquo;d
					love to hear from you.
				</p>

				<div class="contact-page__methods">
					<div class="contact-page__method">
						<span class="contact-page__method-label">Email me</span>
						<span class="contact-page__method-row">
							<a class="contact-page__method-link" href={`mailto:${site.email}`}>
								<span class="contact-page__method-value">{site.email}</span>
							</a>
							<button
								class="contact-page__copy"
								type="button"
								data-copy-email
								data-value={site.email}
								aria-label={`Copy ${site.email} to clipboard`}
							>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<rect
										x="8"
										y="8"
										width="13"
										height="13"
										rx="2"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									/>
									<path
										d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4H4.5A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17H8"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									/>
								</svg>
								<span class="contact-page__copy-tip" data-copy-tip aria-hidden="true">
									Copied!
								</span>
							</button>
						</span>
					</div>
					{
						phoneHref && (
							<a class="contact-page__method" href={phoneHref}>
								<span class="contact-page__method-label">Text me</span>
								<span class="contact-page__method-value">{site.phone}</span>
							</a>
						)
					}
					<div class="contact-page__socials-wrap">
						<span class="contact-page__method-label">Find me elsewhere</span>
						<ul class="contact-page__socials">
							{
								socials.map((s) => (
									<li>
										<a href={s.href} target="_blank" rel="noopener noreferrer">
											{s.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</div>

		<div class="contact-page__art" aria-hidden="true">
			<picture>
				<source
					srcset={withBase("/animations/contact-poster.webp")}
					media="(prefers-reduced-motion: reduce)"
				/>
				<img
					src={withBase("/animations/contact.webp")}
					alt=""
					width="920"
					height="639"
					loading="lazy"
					decoding="async"
				/>
			</picture>
		</div>
	</section>

	<script>
		function initCopyEmail() {
			const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
			if (!btn || btn.dataset.bound) return;
			btn.dataset.bound = 'true';

			const value = btn.dataset.value ?? '';
			let resetTimer = 0;

			btn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(value);
				} catch {
					return; // clipboard blocked — mailto: link next to it still works
				}
				btn.classList.add('is-copied');
				window.clearTimeout(resetTimer);
				resetTimer = window.setTimeout(() => btn.classList.remove('is-copied'), 1600);
			});
		}

		initCopyEmail();
		document.addEventListener('astro:page-load', initCopyEmail);
	</script>
</BaseLayout>
