---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sparkle from '../components/Sparkle.astro';
import { site, socials } from '../config/site';
import '../styles/contact.css';

const phoneHref = site.phone
	? `sms:${site.phone.replace(/\s+/g, '')}`
	: null;
---

<BaseLayout
	title="Contact"
	description={`Get in touch with ${site.name}: email, text and socials.`}
>
	<section class="contact-page">
		<Sparkle
			class="contact-sparkle contact-sparkle--1 sparkle--lg"
			color="var(--color-blush)"
		/>
		<Sparkle class="contact-sparkle contact-sparkle--2" color="var(--color-orange)" />
		<Sparkle class="contact-sparkle contact-sparkle--3" color="var(--color-pink)" />
		<Sparkle
			class="contact-sparkle contact-sparkle--4 sparkle--lg"
			color="var(--color-green)"
		/>
		<Sparkle class="contact-sparkle contact-sparkle--5" color="var(--color-blush)" />

		<div class="contact-page__inner">
			<div class="contact-page__content">
				<h1 class="contact-page__title">
					Let&rsquo;s <span class="contact-page__mark">talk</span>!
				</h1>

				<p class="contact-page__lead">
					Whether it&rsquo;s a project, a question, or just a hello, I&rsquo;d
					love to hear from you.
				</p>

				<div class="contact-page__methods">
					<a class="contact-page__method" href={`mailto:${site.email}`}>
						<span class="contact-page__method-label">Email me</span>
						<span class="contact-page__method-value">{site.email}</span>
					</a>
					{
						phoneHref && (
							<a class="contact-page__method" href={phoneHref}>
								<span class="contact-page__method-label">Text me</span>
								<span class="contact-page__method-value">{site.phone}</span>
							</a>
						)
					}
					<div class="contact-page__socials-wrap">
						<span class="contact-page__method-label">Find me elsewhere</span>
						<ul class="contact-page__socials">
							{
								socials.map((s) => (
									<li>
										<a href={s.href} target="_blank" rel="noopener noreferrer">
											{s.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</div>

		<div class="contact-page__art" aria-hidden="true">
			<picture>
				<source
					srcset="/animations/contact-poster.webp"
					media="(prefers-reduced-motion: reduce)"
				/>
				<img
					src="/animations/contact.webp"
					alt=""
					width="920"
					height="639"
					loading="lazy"
					decoding="async"
				/>
			</picture>
		</div>
	</section>
</BaseLayout>
