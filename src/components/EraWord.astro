---
/** The rotating discipline in "I'm in my ___ era". */
const words = ['design', 'development', 'motion', 'UX/UI'];
---

<span class="era-word" data-era-word>
	<span class="visually-hidden">design, development, motion &amp; UX/UI</span>
	{
		words.map((word, i) => (
			<span
				class:list={['era-word__slot', { 'is-active': i === 0 }]}
				aria-hidden="true"
			>
				<span class="era-word__text">{word}</span>
				<svg
					class="era-word__underline"
					viewBox="0 0 200 12"
					preserveAspectRatio="none"
					aria-hidden="true"
				>
					<path
						d="M3 7C40 3 70 9 100 6C135 2 165 10 197 5"
						fill="none"
						stroke="currentColor"
						stroke-width="3"
						stroke-linecap="round"
					/>
				</svg>
			</span>
		))
	}
</span>

<script>
	function startEraWords() {
		document
			.querySelectorAll<HTMLElement>('[data-era-word]')
			.forEach((root) => {
				if (root.dataset.eraRunning) return;
				const slots = Array.from(root.querySelectorAll('.era-word__slot'));
				if (slots.length < 2) return;
				root.dataset.eraRunning = 'true';

				let i = 0;
				window.setInterval(() => {
					slots[i].classList.remove('is-active');
					i = (i + 1) % slots.length;
					slots[i].classList.add('is-active');
				}, 2000);
			});
	}

	startEraWords();
	document.addEventListener('astro:page-load', startEraWords);
</script>
