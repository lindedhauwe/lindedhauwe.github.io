---
/**
 * Renders text with a per-letter wonky rotation/offset so display headings
 * read as hand-set rather than typeset. Deterministic per character index,
 * so it stays stable across renders.
 */
interface Props {
	text: string;
	/** max rotation in degrees */
	jitter?: number;
}

const { text, jitter = 6 } = Astro.props;

const words = text.split(' ');
// Simple deterministic pseudo-random from an index.
const wobble = (i: number) => {
	const n = Math.sin(i * 12.9898) * 43758.5453;
	return (n - Math.floor(n)) * 2 - 1; // -1..1
};

let charIndex = 0;
---

<span class="tilt" style={`--jitter:${jitter}`}>
	{
		words.map((word, w) => (
			<>
				{w > 0 && <span class="space"> </span>}
				<span class="word">
					{word.split('').map((char) => {
						const r = wobble(charIndex);
						const y = wobble(charIndex + 100);
						charIndex++;
						return (
							<span
								class="char"
								style={`--r:${(r * jitter).toFixed(2)}deg; --y:${(y * 0.06).toFixed(3)}em`}
							>
								{char}
							</span>
						);
					})}
				</span>
			</>
		))
	}
</span>

<style>
	.tilt {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.12em;
	}

	.word {
		display: inline-flex;
		white-space: nowrap;
	}

	.space {
		width: 0.3em;
	}

	.char {
		display: inline-block;
		transform: rotate(var(--r)) translateY(var(--y));
	}

	@media (prefers-reduced-motion: reduce) {
		.char {
			transform: rotate(var(--r));
		}
	}
</style>
