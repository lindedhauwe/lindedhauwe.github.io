---
/* First-visit splash: "Warning! gen-z territory" — shown once per tab
   session (sessionStorage), so it greets you again each time you open
   the site fresh but doesn't interrupt clicking around inside it. The
   show/hide decision for the rest of that session happens before first
   paint via the blocking script in BaseLayout's <head> (adds .gate-skip
   to <html>, which this component's CSS reads); this component only
   handles the reveal → auto-dismiss for the first page load of a session. */
import Sparkle from './Sparkle.astro';
---

<div
	class="intro-gate"
	data-intro-gate
	role="alertdialog"
	aria-modal="true"
	aria-labelledby="intro-gate-heading"
	aria-hidden="true"
	hidden
>
	<Sparkle class="intro-gate__sparkle intro-gate__sparkle--1" color="var(--color-paper)" />
	<Sparkle class="intro-gate__sparkle intro-gate__sparkle--2" color="var(--color-blush)" />
	<Sparkle class="intro-gate__sparkle intro-gate__sparkle--3" color="var(--color-paper)" />
	<Sparkle class="intro-gate__sparkle intro-gate__sparkle--4" color="var(--color-blush)" />
	<Sparkle class="intro-gate__sparkle intro-gate__sparkle--5" color="var(--color-paper)" />

	<div class="intro-gate__inner">
		<p class="intro-gate__eyebrow">⚠ warning ⚠</p>
		<h2 id="intro-gate-heading" class="intro-gate__heading">
			gen-z<br />territory
		</h2>
		<p class="intro-gate__sub">enter at your own risk</p>
		<button class="intro-gate__skip" type="button" data-intro-skip>
			tap to enter &rarr;
		</button>
	</div>
</div>

<script>
	function initIntroGate() {
		const gate = document.querySelector<HTMLElement>('[data-intro-gate]');
		if (!gate || gate.dataset.bound) return;
		gate.dataset.bound = 'true';

		let seen = false;
		try {
			seen = !!sessionStorage.getItem('gateSeen');
		} catch {
			/* storage blocked (private mode etc.) — fall through and show it */
		}
		if (seen) return; // .gate-skip already hides it via CSS, nothing to run

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const skipBtn = gate.querySelector<HTMLButtonElement>('[data-intro-skip]')!;
		const rest = [...document.body.children].filter(
			(el) => el !== gate,
		) as HTMLElement[];

		gate.hidden = false;
		gate.removeAttribute('aria-hidden');
		document.documentElement.style.overflow = 'hidden';
		rest.forEach((el) => el.setAttribute('inert', ''));
		skipBtn.focus();

		// one frame to let the browser register the "hidden" state, then flip
		// to visible so the fade-in actually transitions instead of snapping
		requestAnimationFrame(() => {
			requestAnimationFrame(() => gate!.classList.add('is-visible'));
		});

		let dismissed = false;
		function dismiss() {
			if (dismissed) return;
			dismissed = true;
			window.clearTimeout(timer);
			try {
				sessionStorage.setItem('gateSeen', '1');
			} catch {
				/* nothing we can do — it'll just show again next visit */
			}
			document.documentElement.style.overflow = '';
			rest.forEach((el) => el.removeAttribute('inert'));

			const finish = () => {
				gate!.hidden = true;
				gate!.setAttribute('aria-hidden', 'true');
			};
			if (reduce) {
				finish();
			} else {
				gate!.classList.add('is-leaving');
				gate!.addEventListener('transitionend', finish, { once: true });
			}
		}

		const timer = window.setTimeout(dismiss, 4200);
		skipBtn.addEventListener('click', dismiss);
		gate.addEventListener('click', (e) => {
			if (e.target === gate) dismiss();
		});
		document.addEventListener('keydown', (e) => {
			if (!dismissed && (e.key === 'Escape' || e.key === 'Enter')) dismiss();
		});
	}

	initIntroGate();
	document.addEventListener('astro:page-load', initIntroGate);
</script>
