---
import { nav } from '../config/site';
import { withBase, stripBase } from '../lib/paths';

const current = stripBase(Astro.url.pathname);
const isActive = (href: string) =>
	href === '/' ? current === '/' : current.startsWith(href);

// A few loose, hand-drawn ellipse variants — smooth ovals (the wobble comes
// from the shared #pencil filter) each with its own closing overshoot, so no
// two bubbles share the same scribble and they still read as actually drawn.
const scribblePaths = [
	'M144,25C144,37 113,46 75,46C37,46 6,37 6,25C6,13 37,4 75,4C113,4 144,13 144,25C145,19 141,14 132,11',
	'M75,43C37,43 7,35 7,24C7,14 37,5 75,5C113,5 143,14 143,24C143,35 113,43 75,43C64,44 55,42 50,38',
	'M4,25C4,36 36,45 75,45C114,45 146,36 146,25C146,14 114,5 75,5C36,5 4,14 4,25C3,20 9,15 20,12',
];
---

<header class="site-nav">
	<nav aria-label="Primary">
		<ul>
			{
				nav.map((item, i) => (
					<li>
						<a
							href={withBase(item.href)}
							class:list={['scribble', { 'is-active': isActive(item.href) }]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span>{item.label}</span>
							<svg
								class="scribble__ellipse"
								viewBox="0 0 150 50"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<path
									d={scribblePaths[i % scribblePaths.length]}
									pathLength="100"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
								/>
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
