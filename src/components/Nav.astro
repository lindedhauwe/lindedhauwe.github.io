---
import { nav } from '../config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-nav">
	<nav aria-label="Primary">
		<ul>
			{
				nav.map((item) => (
					<li>
						<a
							href={item.href}
							class:list={['scribble', { 'is-active': isActive(item.href) }]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span>{item.label}</span>
							<svg
								class="scribble__ellipse"
								viewBox="0 0 150 50"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<path
									d="M12 26C10 12 42 5 78 6C122 8 144 17 141 29C138 42 96 47 52 45C20 43 14 38 13 25"
									pathLength="100"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
								/>
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
