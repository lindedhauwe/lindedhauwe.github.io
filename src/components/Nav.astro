---
import { nav } from '../config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-nav">
	<nav aria-label="Primary">
		<ul>
			{
				nav.map((item) => (
					<li>
						<a
							href={item.href}
							class:list={['scribble', { 'is-active': isActive(item.href) }]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span>{item.label}</span>
							<svg
								class="ellipse"
								viewBox="0 0 150 50"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<path
									d="M12 26C10 12 42 5 78 6C122 8 144 17 141 29C138 42 96 47 52 45C20 43 14 38 13 25"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
								/>
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-nav {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: 50;
		display: flex;
		justify-content: flex-end;
		padding: var(--space-s) var(--space-l);
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: flex-end;
		gap: var(--space-2xs) var(--space-s);
		max-width: 22rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* second item sits lower, like the mockup's scattered bubbles */
	nav li:nth-child(3) {
		margin-top: var(--space-m);
	}

	.scribble {
		position: relative;
		display: inline-block;
		padding: 0.4em 1em;
		font-family: var(--font-hand);
		font-size: var(--step-1);
		font-weight: 700;
		text-decoration: none;
		color: var(--nav-fg, var(--color-paper));
	}

	.scribble .ellipse {
		position: absolute;
		inset: -0.15em -0.1em;
		width: calc(100% + 0.2em);
		height: calc(100% + 0.3em);
		color: var(--nav-fg, var(--color-paper));
		opacity: 0.55;
		transform: rotate(-2deg) scale(0.96);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease;
	}

	.scribble:hover .ellipse,
	.scribble:focus-visible .ellipse,
	.scribble.is-active .ellipse {
		opacity: 1;
		transform: rotate(-2deg) scale(1);
	}

	nav li:nth-child(2) .ellipse {
		transform: rotate(3deg) scale(0.96);
	}
	nav li:nth-child(2) .scribble:hover .ellipse,
	nav li:nth-child(2) .scribble:focus-visible .ellipse,
	nav li:nth-child(2) .scribble.is-active .ellipse {
		transform: rotate(3deg) scale(1);
	}
</style>
