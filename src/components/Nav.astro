---
import { nav } from '../config/site';
import { withBase, stripBase } from '../lib/paths';

const current = stripBase(Astro.url.pathname);
const isActive = (href: string) =>
	href === '/' ? current === '/' : current.startsWith(href);

// A few loose, hand-drawn ellipse variants — each overshoots or leaves a gap so
// no two bubbles share the same scribble and they read as actually drawn.
const scribblePaths = [
	'M22 40C6 31 6 13 30 7C60 0 112 3 136 13C151 19 147 35 121 42C91 50 39 49 16 39C9 36 8 31 13 27',
	'M16 22C13 9 45 3 82 5C120 7 145 15 138 27C132 40 94 47 50 44C17 41 6 29 19 17C25 11 36 9 48 9',
	'M26 11C59 2 116 4 139 14C153 22 143 36 114 42C80 49 27 47 12 35C2 27 9 14 31 8C37 7 45 7 53 8',
];
---

<header class="site-nav">
	<nav aria-label="Primary">
		<ul>
			{
				nav.map((item, i) => (
					<li>
						<a
							href={withBase(item.href)}
							class:list={['scribble', { 'is-active': isActive(item.href) }]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span>{item.label}</span>
							<svg
								class="scribble__ellipse"
								viewBox="0 0 150 50"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<path
									d={scribblePaths[i % scribblePaths.length]}
									pathLength="100"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
								/>
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
