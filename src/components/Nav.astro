---
import { nav } from '../config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? current === '/' : current.startsWith(href);

// A few loose, hand-drawn ellipse variants — each overshoots or leaves a gap so
// no two bubbles share the same scribble and they read as actually drawn.
const scribblePaths = [
	'M14 30C7 15 34 6 68 5C96 4 122 6 138 12C150 17 149 27 138 33C120 42 78 48 44 45C18 43 6 34 12 21C15 15 22 12 32 10C39 9 46 9 41 13',
	'M24 12C52 3 116 3 137 13C151 20 146 33 122 40C88 50 30 49 12 37C1 29 6 16 27 9C33 7 41 7 51 8C46 5 39 5 33 7',
	'M18 19C11 8 40 3 78 5C112 7 146 9 139 24C134 36 104 47 56 45C20 43 8 31 17 18C21 12 29 9 41 9C35 7 28 9 22 13',
];
---

<header class="site-nav">
	<nav aria-label="Primary">
		<ul>
			{
				nav.map((item, i) => (
					<li>
						<a
							href={item.href}
							class:list={['scribble', { 'is-active': isActive(item.href) }]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span>{item.label}</span>
							<svg
								class="scribble__ellipse"
								viewBox="0 0 150 50"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<path
									d={scribblePaths[i % scribblePaths.length]}
									pathLength="100"
									fill="none"
									stroke="currentColor"
									stroke-width="3.6"
									stroke-linecap="round"
								/>
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
