---
/* A hand-drawn 4-point sparkle (the favicon mark), used as scattered
   decoration to break up empty space. Roughened by the shared #pencil filter.
   Decorative only. */
interface Props {
	color?: string;
	class?: string;
}
const { color = 'currentColor', class: className } = Astro.props;
---

<svg
	class:list={['sparkle', className]}
	viewBox="0 0 128 128"
	aria-hidden="true"
	style={`color:${color}`}
>
	<path
		fill="currentColor"
		d="M64 20c3 0 5 2 6 5l8 26c1 3 3 5 6 6l26 8c3 1 5 3 5 6s-2 5-5 6l-26 8c-3 1-5 3-6 6l-8 26c-1 3-3 5-6 5s-5-2-6-5l-8-26c-1-3-3-5-6-6l-26-8c-3-1-5-3-5-6s2-5 5-6l26-8c3-1 5-3 6-6l8-26c1-3 3-5 6-5Z"
	></path>
</svg>
